<!--
  Windows installer (WiX v5). Built by .github/workflows/desktop-build.yml:

    wix build desktop\windows\productivity-suite.wxs -arch x64
      -d Version=0.1.0 -d SourceDir=<abs path to PyInstaller dist\ProductivitySuite>
      -d IconFile=<abs path to desktop\assets\icon.ico> -o ProductivitySuite-0.1.0-x64.msi

  Per-machine install to Program Files with a Start menu shortcut. The UpgradeCode must
  never change: it is how Windows recognises a newer version and upgrades in place.
  User settings and data live in %USERPROFILE%\.productivity-suite and survive uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Productivity Suite"
           Manufacturer="Productivity Suite"
           Version="$(var.Version)"
           UpgradeCode="53BE070A-4D7D-4B03-AA06-1DB55247D604"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Productivity Suite is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The Icon Id keeps the .ico extension: Windows uses it to read the icon for the shortcut and Apps list. -->
    <Icon Id="ProductivitySuite.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ProductivitySuite.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ilbambinomx/Productivity-Agents" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Productivity Suite" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Productivity Suite">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**">
        <Exclude Files="$(var.SourceDir)\ProductivitySuite.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER">
      <File Id="MainExe" Source="$(var.SourceDir)\ProductivitySuite.exe" KeyPath="yes" />
    </Component>

    <!-- A plain (non-advertised) shortcut pointing at the exe, with the icon set explicitly. Advertised
         shortcuts take their icon from the Icon table under stricter naming rules and can show blank. -->
    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuShortcut" Name="Productivity Suite"
                Description="Governed agent playbooks that run on your computer"
                Target="[INSTALLFOLDER]ProductivitySuite.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ProductivitySuite.ico" IconIndex="0" />
      <RegistryValue Root="HKLM" Key="Software\Productivity Suite" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
