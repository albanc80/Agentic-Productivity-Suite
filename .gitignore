# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Local configuration and data (may contain your data or settings)
config/suite.yaml
config/connectors.yaml
config/profile.yaml
data/
evals/data/
evals/reports/
*.db
*.db-wal
*.db-shm
.env
# OAuth clients built into the app (written by CI from a secret; keep your own copy out of git)
config/google-oauth-client.json
config/agent-pack.key
# Agent pack keys and plain packs (only registry/agent-pack.enc, encrypted, is committed)
*.key
agent-pack*.zip
client_secret*.json

# Desktop builds
/tools/
backend/build/
backend/dist/
*.spec.bak
installers/
*.msi
*.deb
install.log

# Archives at the repository root (for example private agent sources); never committed
/*.zip

# Private agent layer (instructions, personas, lineage) - never commit
/private-registry/
